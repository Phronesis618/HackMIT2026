    "lore": [
      { "kind": "relic", "roomIndex": 0, "enemyId": null, "title": "Departures board",
        "text": "Every line reads DELAYED except the last, which reads NOWHERE and is still blinking." },
      { "kind": "relic", "roomIndex": 0, "enemyId": null, "title": "Left luggage tag",
        "text": "Hold for collection. Owner will return once the tower decides which world it is in. Signed, in a hurry, twice." },
      { "kind": "relic", "roomIndex": 1, "enemyId": null, "title": "Line engineer's chalk note",
        "text": "Cut trunk 4 before it cuts you. The relay is not routing passengers any more; it is routing itself." },
      { "kind": "relic", "roomIndex": 2, "enemyId": null, "title": "Vault door plaque",
        "text": "Anchor bay. Plant nothing you are not willing to leave behind. The spire keeps what is planted." },
      { "kind": "remains", "roomIndex": 0, "enemyId": "husk", "title": "Commuter's ticket stub",
        "text": "Punched for a platform that no longer exists. The husks were the last passengers, still waiting for a train the spire forgot to send." },
      { "kind": "remains", "roomIndex": 0, "enemyId": "sentinel", "title": "Platform warden's lamp",
        "text": "Cracked lens, warm glass. Sentinels were the platform wardens who kept the crowds in line, and kept doing it after the crowds were gone." },
      { "kind": "remains", "roomIndex": 0, "enemyId": "guardian", "title": "Relay core fragment",
        "text": "Still humming with six voices at once. The Guardian was the relay's own switching heart, defending the one world it had left to route to." }
    ]
