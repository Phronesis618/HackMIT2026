# Copy to `.env` (git-ignored). Every value here is a placeholder, never a credential.
# All of these are read ONLY by the Node server (src/server/config.ts). The browser
# client never sees them; Vite only exposes variables prefixed VITE_, and we define none.

# --- Server ---
# Port the Node server listens on. Vite's dev proxy targets this port too.
PORT=8787
# Bind address. 127.0.0.1 = this laptop only. 0.0.0.0 = reachable on the LAN
# (needed for the two-laptop presentation). Production defaults to 0.0.0.0.
HOST=127.0.0.1

# --- World generation (Agent B / feat/generation) ---
# fixture = always return the validated offline fixture (default, no network, free).
# live    = call the selected provider; falls back to a labeled fixture on failure.
RELAY_GENERATION_MODE=fixture
# composer  = no key: the offline composer builds a distinct, honestly-labelled world from the
#             players' ideas in milliseconds (also the fallback for every other provider).
# anthropic = Claude; openai = GPT (need a key). operator = DEMO ONLY, no key: each request is
#             written to .relay/operator/inbox and a coding agent watching that folder writes the
#             WorldRecipe reply. See docs/DEMO.md. Restart the server after changing.
RELAY_AI_PROVIDER=composer
# Set RELAY_GENERATION_MODE=live and supply the selected provider's key to enable AI.
# Leave keys empty for offline development. Never prefix secrets with VITE_.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# operator only: where requests/replies live and how long to wait before the labelled fallback.
RELAY_OPERATOR_DIR=.relay/operator
RELAY_OPERATOR_TIMEOUT_MS=180000

# Floors worlds (5 biomes deep, room graphs); see docs/design/FLOORS.md.
# Enabled in this example and the Render Blueprint. Set to 0 for legacy three-room worlds.
RELAY_FLOORS=1
# Derive laws and a look for worlds whose recipe has none. Set to 0 to opt out.
# Authored laws still apply when this flag is off.
RELAY_LAWS=1
