# Copy to `.env` (git-ignored). Every value here is a placeholder, never a credential.
# All of these are read ONLY by the Node server (src/server/config.ts). The browser
# client never sees them; Vite only exposes variables prefixed VITE_, and we define none.

# --- Server ---
# Port the Node server listens on. Vite's dev proxy targets this port too.
PORT=8787
# Bind address. 127.0.0.1 = this laptop only. 0.0.0.0 = reachable on the LAN
# (needed for the two-laptop presentation). Production defaults to 0.0.0.0.
HOST=127.0.0.1

# --- World generation (Agent B / feat/generation) ---
# fixture = always return the validated offline fixture (default, no network, free).
# live    = attempt an OpenAI call; falls back to a labeled fixture on any failure.
RELAY_GENERATION_MODE=fixture
# Leave empty for local development. Missing credentials never block startup.
OPENAI_API_KEY=
# Model name placeholder — Agent B verifies the current model list in the OpenAI
# docs before enabling live mode. Not validated by the foundation.
OPENAI_MODEL=gpt-5-mini
